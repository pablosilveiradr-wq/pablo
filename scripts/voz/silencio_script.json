[["Llegás a casa y lo primero", "que hacés es prender algo."], ["La tele. Un podcast.", "El celular."], ["Cualquier cosa,", "menos el silencio."], ["Porque en el silencio aparece", "lo que venías esquivando."], ["Es como un vaso", "de agua con arena."], ["Si lo movés todo el tiempo,", "nunca se aclara."], ["Si lo dejás quieto un minuto,", "la arena baja."], ["Probá hoy:", "un minuto, sin nada."], ["Sin pantalla, sin música."], ["Dejá que la arena baje."], ["En el silencio,", "lo que importa", "se escucha mejor."]]