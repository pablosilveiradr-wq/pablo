{"scenes": [{"start": 0, "end": 3.28}, {"start": 3.28, "end": 4.5}, {"start": 4.5, "end": 5.96}, {"start": 5.96, "end": 7.76}, {"start": 7.76, "end": 9.04}, {"start": 9.04, "end": 11.38}, {"start": 11.38, "end": 13.18}, {"start": 13.18, "end": 14.56}, {"start": 14.56, "end": 16.44}, {"start": 16.44, "end": 17.94}, {"start": 17.94, "end": 20.04}, {"start": 20.04, "end": 22.42}, {"start": 22.42, "end": 23.26}, {"start": 23.26, "end": 24.12}, {"start": 24.12, "end": 25.06}, {"start": 25.06, "end": 28.64}], "lines": [{"text": "Entre lo que te pasa y lo que hacés,", "start": 0.22, "scene": 0, "row": 0, "words": [0.04, 0.28, 0.44, 0.54, 0.66, 1.0, 1.32, 1.42, 1.54], "end": 3.28}, {"text": "hay un espacio.", "start": 2.1, "scene": 0, "row": 1, "words": [0.04, 0.48, 0.62], "end": 3.28}, {"text": "Casi nunca lo ves.", "start": 3.32, "scene": 1, "row": 0, "words": [0.04, 0.26, 0.54, 0.76], "end": 4.5}, {"text": "Dura menos que un segundo.", "start": 4.54, "scene": 2, "row": 0, "words": [0.04, 0.24, 0.52, 0.72, 0.8], "end": 5.96}, {"text": "Ahí entra una respiración.", "start": 6.0, "scene": 3, "row": 0, "words": [0.04, 0.26, 0.76, 0.92], "end": 7.76}, {"text": "Ahí entra una pregunta.", "start": 7.8, "scene": 4, "row": 0, "words": [0.04, 0.2, 0.66, 0.8], "end": 9.04}, {"text": "Ahí entra la versión tuya", "start": 9.08, "scene": 5, "row": 0, "words": [0.04, 0.28, 0.72, 0.84, 1.12], "end": 11.38}, {"text": "que elige.", "start": 10.64, "scene": 5, "row": 1, "words": [0.04, 0.16], "end": 11.38}, {"text": "Un mensaje que contestás más tarde.", "start": 11.42, "scene": 6, "row": 0, "words": [0.04, 0.16, 0.52, 0.66, 1.1, 1.2], "end": 13.18}, {"text": "Una palabra que te guardás.", "start": 13.22, "scene": 7, "row": 0, "words": [0.04, 0.14, 0.44, 0.64, 0.74], "end": 14.56}, {"text": "Una puerta que cerrás despacio.", "start": 14.6, "scene": 8, "row": 0, "words": [0.04, 0.18, 0.54, 0.92, 1.58], "end": 16.44}, {"text": "Nadie aplaude ese espacio.", "start": 16.48, "scene": 9, "row": 0, "words": [0.04, 0.28, 0.8, 0.9], "end": 17.94}, {"text": "Pero ahí se decide casi todo.", "start": 17.98, "scene": 10, "row": 0, "words": [0.04, 0.2, 0.46, 0.78, 1.12, 1.4], "end": 20.04}, {"text": "Cuanto más lo usás,", "start": 20.08, "scene": 11, "row": 0, "words": [0.04, 0.2, 0.5, 0.66], "end": 22.42}, {"text": "más grande se hace.", "start": 21.08, "scene": 11, "row": 1, "words": [0.04, 0.4, 0.72, 0.94], "end": 22.42}, {"text": "Una pausa.", "start": 22.46, "scene": 12, "row": 0, "words": [0.04, 0.18], "end": 23.26}, {"text": "Un respiro.", "start": 23.3, "scene": 13, "row": 0, "words": [0.04, 0.1], "end": 24.12}, {"text": "Una elección.", "start": 24.16, "scene": 14, "row": 0, "words": [0.04, 0.14], "end": 25.06}, {"text": "Ese espacio también sos vos.", "start": 25.1, "scene": 15, "row": 0, "words": [0.04, 0.22, 0.64, 1.24, 1.5], "end": 28.64}], "seconds": 28.64}
