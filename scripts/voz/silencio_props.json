{"scenes": [{"start": 0, "end": 3.28}, {"start": 3.28, "end": 5.28}, {"start": 5.28, "end": 7.7}, {"start": 7.7, "end": 10.48}, {"start": 10.48, "end": 12.1}, {"start": 12.1, "end": 14.48}, {"start": 14.48, "end": 17.2}, {"start": 17.2, "end": 19.5}, {"start": 19.5, "end": 21.1}, {"start": 21.1, "end": 22.44}, {"start": 22.44, "end": 26.98}], "lines": [{"text": "Llegás a casa y lo primero", "start": 0.22, "scene": 0, "row": 0, "words": [0.04, 0.32, 0.46, 0.7, 1.02, 1.14], "end": 3.28}, {"text": "que hacés es prender algo.", "start": 1.74, "scene": 0, "row": 1, "words": [0.04, 0.26, 0.54, 0.78, 1.36], "end": 3.28}, {"text": "La tele. Un podcast.", "start": 3.32, "scene": 1, "row": 0, "words": [0.04, 0.1, 0.62, 0.72], "end": 5.28}, {"text": "El celular.", "start": 4.66, "scene": 1, "row": 1, "words": [0.04, 0.08], "end": 5.28}, {"text": "Cualquier cosa,", "start": 5.32, "scene": 2, "row": 0, "words": [0.04, 0.22], "end": 7.7}, {"text": "menos el silencio.", "start": 6.12, "scene": 2, "row": 1, "words": [0.04, 0.5, 0.76], "end": 7.7}, {"text": "Porque en el silencio aparece", "start": 7.74, "scene": 3, "row": 0, "words": [0.04, 0.08, 0.2, 0.3, 0.84], "end": 10.48}, {"text": "lo que venías esquivando.", "start": 8.98, "scene": 3, "row": 1, "words": [0.04, 0.3, 0.4, 0.74], "end": 10.48}, {"text": "Es como un vaso", "start": 10.52, "scene": 4, "row": 0, "words": [0.04, 0.16, 0.32, 0.46], "end": 12.1}, {"text": "de agua con arena.", "start": 11.22, "scene": 4, "row": 1, "words": [0.04, 0.12, 0.28, 0.48], "end": 12.1}, {"text": "Si lo movés todo el tiempo,", "start": 12.14, "scene": 5, "row": 0, "words": [0.04, 0.14, 0.37, 0.5, 0.66, 0.88], "end": 14.48}, {"text": "nunca se aclara.", "start": 13.26, "scene": 5, "row": 1, "words": [0.04, 0.5, 0.76], "end": 14.48}, {"text": "Si lo dejás quieto un minuto,", "start": 14.52, "scene": 6, "row": 0, "words": [0.04, 0.16, 0.37, 0.46, 0.9, 1.1], "end": 17.2}, {"text": "la arena baja.", "start": 16.34, "scene": 6, "row": 1, "words": [0.04, 0.22, 0.4], "end": 17.2}, {"text": "Probá hoy:", "start": 17.24, "scene": 7, "row": 0, "words": [0.04, 0.28], "end": 19.5}, {"text": "un minuto, sin nada.", "start": 18.0, "scene": 7, "row": 1, "words": [0.04, 0.16, 0.78, 1.04], "end": 19.5}, {"text": "Sin pantalla, sin música.", "start": 19.54, "scene": 8, "row": 0, "words": [0.04, 0.16, 0.76, 0.92], "end": 21.1}, {"text": "Dejá que la arena baje.", "start": 21.14, "scene": 9, "row": 0, "words": [0.04, 0.24, 0.42, 0.52, 0.74], "end": 22.44}, {"text": "En el silencio,", "start": 22.48, "scene": 10, "row": 0, "words": [0.04, 0.16, 0.26], "end": 26.98}, {"text": "lo que importa", "start": 23.48, "scene": 10, "row": 1, "words": [0.04, 0.16, 0.28], "end": 26.98}, {"text": "se escucha mejor.", "start": 24.1, "scene": 10, "row": 2, "words": [0.04, 0.46, 0.84], "end": 26.98}], "seconds": 26.98}
