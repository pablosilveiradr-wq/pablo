{
 "hookEnd": 3.56,
 "captions": [
  {
   "text": "Si querés concentrarte",
   "start": 0,
   "end": 1.26
  },
  {
   "text": "y tu cabeza salta",
   "start": 1.26,
   "end": 2.04
  },
  {
   "text": "de una cosa a otra",
   "start": 2.04,
   "end": 2.84
  },
  {
   "text": "todo el tiempo",
   "start": 2.84,
   "end": 3.56
  },
  {
   "text": "te explico",
   "start": 3.56,
   "end": 4.1
  },
  {
   "text": "por qué te pasa esto",
   "start": 4.1,
   "end": 5.06
  },
  {
   "text": "y qué hacer",
   "start": 5.06,
   "end": 5.84
  },
  {
   "text": "Tu atención",
   "start": 5.84,
   "end": 6.2
  },
  {
   "text": "es un recurso limitado",
   "start": 6.2,
   "end": 8.44
  },
  {
   "text": "la corteza prefrontal",
   "start": 8.44,
   "end": 9.68
  },
  {
   "text": "la parte del cerebro",
   "start": 9.68,
   "end": 10.52
  },
  {
   "text": "que te ayuda",
   "start": 10.52,
   "end": 10.98
  },
  {
   "text": "a concentrarte",
   "start": 10.98,
   "end": 11.76
  },
  {
   "text": "sostiene pocas cosas",
   "start": 11.76,
   "end": 12.84
  },
  {
   "text": "a la vez",
   "start": 12.84,
   "end": 13.4
  },
  {
   "text": "Cuando algo la tironea",
   "start": 13.4,
   "end": 14.56
  },
  {
   "text": "pierde el hilo",
   "start": 14.56,
   "end": 15.24
  },
  {
   "text": "Probá esto ahora",
   "start": 15.24,
   "end": 16.26
  },
  {
   "text": "dejá el celular",
   "start": 16.26,
   "end": 16.92
  },
  {
   "text": "en otra habitación",
   "start": 16.92,
   "end": 18.04
  },
  {
   "text": "boca abajo",
   "start": 18.04,
   "end": 19.02
  },
  {
   "text": "en la mesa no alcanza",
   "start": 19.02,
   "end": 20.38
  },
  {
   "text": "tiene que estar",
   "start": 20.38,
   "end": 20.84
  },
  {
   "text": "fuera de tu vista",
   "start": 20.84,
   "end": 21.96
  },
  {
   "text": "Esto lo midieron",
   "start": 21.96,
   "end": 22.68
  },
  {
   "text": "Sólo con tener",
   "start": 22.68,
   "end": 23.2
  },
  {
   "text": "el celular cerca",
   "start": 23.2,
   "end": 24.1
  },
  {
   "text": "aunque esté apagado",
   "start": 24.1,
   "end": 25.42
  },
  {
   "text": "la gente rendía peor",
   "start": 25.42,
   "end": 26.56
  },
  {
   "text": "Una parte de tu cabeza",
   "start": 26.56,
   "end": 27.5
  },
  {
   "text": "queda ocupada",
   "start": 27.5,
   "end": 28.24
  },
  {
   "text": "en no mirarlo",
   "start": 28.24,
   "end": 29.06
  },
  {
   "text": "Cuando sacás",
   "start": 29.06,
   "end": 29.68
  },
  {
   "text": "lo que tironea",
   "start": 29.68,
   "end": 30.7
  },
  {
   "text": "tu cabeza vuelve",
   "start": 30.7,
   "end": 31.86
  },
  {
   "text": "a tener lugar para vos",
   "start": 31.86,
   "end": 33.4
  },
  {
   "text": "Te veo",
   "start": 33.4,
   "end": 33.72
  },
  {
   "text": "en la próxima píldora",
   "start": 33.72,
   "end": 35.0
  }
 ],
